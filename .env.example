# MongoDB connection
MONGO_URI=mongodb://localhost:27017/hostel_management

# Server settings
PORT=5000
NODE_ENV=development

# Authentication
secrettoken=change_this_to_a_strong_secret_key
DEFAULT_ADMIN_PASSWORD=admin123

# Optional: Razorpay (required only for online payment features)
# razorpaykeyid=your_razorpay_key_id
# razorpaykey=your_razorpay_key_secret

# Optional: Fast2SMS (SMS notifications)
# FAST2SMS_API_KEY=your_fast2sms_api_key

# Optional: Brevo / Sendinblue (legacy OTP emails)
# mailapikey=your_brevo_api_key
